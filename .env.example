# Clé Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optionnel : pré-filtre TypeSafe (Jev) qui évite d'appeler Gemini sur le bruit
TYPESAFE_API_KEY=

# Optionnel : modèles
# GEMINI_MODEL=gemini-3.6-flash          # notation + fiches
# GEMINI_CHAT_MODEL=gemini-pro-latest    # conversation
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts  # voix
# GEMINI_TTS_VOICE=Charon

MIN_INTEREST_SCORE=7
POLL_INTERVAL_SECONDS=60
