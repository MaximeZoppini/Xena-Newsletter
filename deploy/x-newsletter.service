[Unit]
Description=Xena - veille d'actualité personnelle (site web + analyse)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/x-newsletter
ExecStart=/opt/x-newsletter/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=-/opt/x-newsletter/.env

[Install]
WantedBy=multi-user.target
